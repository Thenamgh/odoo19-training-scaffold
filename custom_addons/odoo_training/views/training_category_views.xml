<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_training_category_list" model="ir.ui.view">
        <field name="name">training.category.list</field>
        <field name="model">training.category</field>
        <field name="arch" type="xml">
            <list string="Danh mục thực hành">
                <field name="name"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_training_category_form" model="ir.ui.view">
        <field name="name">training.category.form</field>
        <field name="model">training.category</field>
        <field name="arch" type="xml">
            <form string="Danh mục thực hành">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Hồ sơ" name="items">
                            <field name="item_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_training_category_search" model="ir.ui.view">
        <field name="name">training.category.search</field>
        <field name="model">training.category</field>
        <field name="arch" type="xml">
            <search string="Tìm danh mục">
                <field name="name"/>
                <filter name="archived" string="Đã lưu trữ"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="action_training_category" model="ir.actions.act_window">
        <field name="name">Danh mục</field>
        <field name="res_model">training.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_training_category_search"/>
    </record>
</odoo>
